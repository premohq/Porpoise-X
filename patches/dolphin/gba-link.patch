+      auto& requests = HW::GBA::RequestsFor(m_device_number);
+      std::lock_guard lock(requests.lock);
+      if (requests.queue.empty())
+        break;
+      request = std::move(requests.queue.front());
+      requests.queue.pop_front();
+    }
+    const std::string& path = request.second;
+    switch (request.first)
+    {
+    case HW::GBA::Request::Connect:
+    case HW::GBA::Request::Disconnect:
