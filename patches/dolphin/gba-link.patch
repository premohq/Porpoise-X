+// True when fd can take more data (false after timeout_ms, or on error).
+bool WaitWritable(int fd, int timeout_ms)
+{
+  if (fd < 0 || fd >= FD_SETSIZE)
+    return false;
+  fd_set set;
+  FD_ZERO(&set);
+  FD_SET(fd, &set);
+  timeval tv{};
+  tv.tv_sec = timeout_ms / 1000;
+  tv.tv_usec = (timeout_ms % 1000) * 1000;
+  return ::select(fd + 1, nullptr, &set, nullptr, &tv) > 0;
+}
+
+void SetNonBlocking(int fd)
+{
+  const int flags = ::fcntl(fd, F_GETFL, 0);
+  if (flags != -1)
+    (void)::fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+}
+
+// True when fd has something to read (or has failed: the read then says so).
+bool WaitReadable(int fd, int timeout_ms)
+{
+  if (fd < 0 || fd >= FD_SETSIZE)
+    return false;
+  fd_set set;
+  FD_ZERO(&set);
+  FD_SET(fd, &set);
+  timeval tv{};
+  tv.tv_sec = timeout_ms / 1000;
+  tv.tv_usec = (timeout_ms % 1000) * 1000;
+  return ::select(fd + 1, &set, nullptr, nullptr, &tv) > 0;
+}
+
+Fd OpenListener(u16 port)
+{
+  Fd fd(::socket(AF_INET, SOCK_STREAM, 0));
+  if (!fd)
+    return {};
+  // Without this the port is unusable for about a minute after the content closes: the
+  // connections this server closed linger in TIME_WAIT.
+  const int yes = 1;
+  (void)::setsockopt(fd.Get(), SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
+  sockaddr_in addr{};
+  addr.sin_family = AF_INET;
+  addr.sin_addr.s_addr = htonl(INADDR_ANY);
+  addr.sin_port = htons(port);
+  if (::bind(fd.Get(), reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) != 0)
+  {
+    ERROR_LOG_FMT(SERIALINTERFACE, "GBA web: bind failed, errno {}", errno);
+    return {};
+  }
+  if (::listen(fd.Get(), 8) != 0)
+  {
+    ERROR_LOG_FMT(SERIALINTERFACE, "GBA web: listen failed, errno {}", errno);
+    return {};
+  }
+  SetNonBlocking(fd.Get());
+  return fd;
+}
+
+bool SendAll(int fd, const void* data, std::size_t size)
+{
+  State& s = S();
+  const char* p = static_cast<const char*>(data);
+  std::size_t off = 0;
+  long long last_progress = NowMs();
+  while (off < size)
+  {
+    if (s.stop)
+      return false;
+    const ssize_t n = ::send(fd, p + off, size - off, SEND_FLAGS);
+    if (n > 0)
+    {
+      off += static_cast<std::size_t>(n);
+      last_progress = NowMs();
+      continue;
+    }
+    if (n < 0 && errno == EINTR)
+      continue;
+    // ENOBUFS / ENOMEM are the console's network stack running short of buffers for a moment.
+    if (n < 0 && errno != EAGAIN && errno != EWOULDBLOCK && errno != ENOBUFS && errno != ENOMEM)
+    {
+      WARN_LOG_FMT(SERIALINTERFACE, "GBA web: send failed, errno {} ({} of {} bytes sent)", errno, off,
+                   size);
+      return false;  // disconnected or error
+    }
+    if (NowMs() - last_progress > STALL_LIMIT_MS)
+    {
+      WARN_LOG_FMT(SERIALINTERFACE, "GBA web: a browser took nothing for {} ms ({} of {} bytes): dropped",
+                   STALL_LIMIT_MS, off, size);
+      return false;
+    }
+    // Woken the moment the console's network stack has room again; a timed sleep can cost a whole
+    // scheduler tick each time the socket fills, which at a frame per round trip adds up. (The
+    // buffer-shortage errors have no such signal, so they get a short sleep.)
+    if (n < 0 && (errno == ENOBUFS || errno == ENOMEM))
+      std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    else
+      (void)WaitWritable(fd, 20);
+  }
+  return true;
+}
+
+bool SendText(int fd, const std::string& text)
+{
+  return SendAll(fd, text.data(), text.size());
+}
+
+// Reads up to and including the blank line after a request's header into head; bytes after it
+// stay in buf for the next request on the connection.
+bool ReadHead(int fd, std::string& buf, std::string& head)
+{
+  State& s = S();
+  long long last_data = NowMs();
+  for (;;)
+  {
+    const std::size_t end = buf.find("\r\n\r\n");
+    if (end != std::string::npos)
+    {
+      head = buf.substr(0, end);
+      buf.erase(0, end + 4);
+      return true;
+    }
+    if (buf.size() > 8192 || s.stop || NowMs() - last_data > KEEPALIVE_IDLE_MS)
+      return false;
+    if (!WaitReadable(fd, 100))
+      continue;
+    char tmp[1024];
+    const ssize_t n = ::recv(fd, tmp, sizeof(tmp), 0);
+    if (n > 0)
+    {
+      buf.append(tmp, static_cast<std::size_t>(n));
+      last_data = NowMs();
+    }
+    else if (n == 0 || (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR))
+    {
+      return false;
+    }
+  }
+}
+
+struct Request
+{
+  std::string method;
+  std::string path;
+  std::string query;
+};
+
+bool ParseRequest(const std::string& head, Request& r)
+{
+  const std::string line = head.substr(0, head.find("\r\n"));
+  const std::size_t sp1 = line.find(' ');
+  if (sp1 == std::string::npos)
+    return false;
+  const std::size_t sp2 = line.find(' ', sp1 + 1);
+  if (sp2 == std::string::npos)
+    return false;
+  r.method = line.substr(0, sp1);
+  const std::string target = line.substr(sp1 + 1, sp2 - sp1 - 1);
+  const std::size_t qm = target.find('?');
+  r.path = target.substr(0, qm);
+  r.query = qm == std::string::npos ? std::string{} : target.substr(qm + 1);
+  return !r.path.empty() && r.path[0] == '/';
+}
+
+std::string QueryValue(const std::string& query, const std::string& key)
+{
+  std::size_t pos = 0;
+  while (pos <= query.size())
+  {
+    std::size_t amp = query.find('&', pos);
+    if (amp == std::string::npos)
+      amp = query.size();
+    const std::string pair = query.substr(pos, amp - pos);
+    const std::size_t eq = pair.find('=');
+    if (eq != std::string::npos && pair.compare(0, eq, key) == 0)
+      return pair.substr(eq + 1);
+    pos = amp + 1;
+  }
+  return {};
+}
+
+// A decimal number, or def if the text is empty or not one; never above max.
+unsigned ParseUInt(const std::string& text, unsigned def, unsigned max)
+{
+  if (text.empty() || text.size() > 10)
+    return def;
+  unsigned long long v = 0;
+  for (const char c : text)
+  {
+    if (c < '0' || c > '9')
+      return def;
+    v = v * 10 + static_cast<unsigned>(c - '0');
+  }
+  return static_cast<unsigned>(std::min<unsigned long long>(v, max));
+}
+
+// The controller port (1-4, as in RetroArch's menu) named in the request, as a device index;
+// -1 for "whichever GBA is active".
+int RequestedDevice(const Request& r)
+{
+  const unsigned port = ParseUInt(QueryValue(r.query, "p"), 0, 99);
+  return port >= 1 && port <= MAX_DEVICES ? static_cast<int>(port) - 1 : -1;
+}
+
+int LowestActive(const State& s)  // with s.m held
+{
+  for (int i = 0; i < MAX_DEVICES; ++i)
+  {
+    if (s.slots[i].active)
+      return i;
+  }
+  return -1;
+}
+
+std::string Header(int code, const char* reason, const char* type, std::size_t length,
+                   bool keep_alive, const std::string& extra = {})
+{
+  std::string h = "HTTP/1.1 " + std::to_string(code) + " " + reason + "\r\n";
+  if (type)
+    h += std::string("Content-Type: ") + type + "\r\n";
+  h += "Content-Length: " + std::to_string(length) + "\r\n";
+  h += "Cache-Control: no-store\r\n";
+  h += extra;
+  h += keep_alive ? "Connection: keep-alive\r\n\r\n" : "Connection: close\r\n\r\n";
+  return h;
+}
+
+// Lossless, no dependencies, and a few hundred microseconds. Each pixel is first replaced by its XOR
+// with the one above (so repeated rows, flat areas and vertical patterns become zeros), then the
+// result is packed as 16-bit symbols, PackBits style: a control byte below 128 is that many plus one
+// literal symbols (1-128) that follow; 128 and above is a run of (byte - 125) copies (3-130) of the
+// one symbol that follows. The worst case, all symbols different, grows by under one percent.
+void CompressFrame(const std::vector<u16>& px, u16 width, std::vector<u8>& out)
+{
+  const std::size_t n = px.size();
+  std::vector<u16> d(n);
+  for (std::size_t i = 0; i < n; ++i)
+    d[i] = i < width ? px[i] : static_cast<u16>(px[i] ^ px[i - width]);
+
+  out.clear();
+  out.reserve(n / 2 + 16);
+  const auto put16 = [&out](u16 v) {
+    out.push_back(static_cast<u8>(v & 0xFF));
+    out.push_back(static_cast<u8>(v >> 8));
+  };
+  std::size_t i = 0;
+  while (i < n)
+  {
+    std::size_t run = 1;
+    while (i + run < n && d[i + run] == d[i] && run < 130)
+      ++run;
+    if (run >= 3)
+    {
+      out.push_back(static_cast<u8>(0x80 | (run - 3)));
+      put16(d[i]);
+      i += run;
+      continue;
+    }
+    const std::size_t start = i;
+    std::size_t count = 0;
+    while (i < n && count < 128)
+    {
+      std::size_t r = 1;
+      while (i + r < n && d[i + r] == d[i] && r < 3)
+        ++r;
+      if (r >= 3)
+        break;
+      ++i;
+      ++count;
+    }
+    out.push_back(static_cast<u8>(count - 1));
+    for (std::size_t k = 0; k < count; ++k)
+      put16(d[start + k]);
+  }
+}
+
+// 'GBA1', width, height, then the pixels; with s.m held.
+void BuildFrameMessage(const Slot& slot, std::vector<u8>& msg)
+{
+  const std::size_t bytes = slot.pixels.size() * sizeof(u16);
+  msg.resize(8 + bytes);
+  msg[0] = 'G';
+  msg[1] = 'B';
+  msg[2] = 'A';
+  msg[3] = '1';
+  msg[4] = static_cast<u8>(slot.width & 0xFF);
+  msg[5] = static_cast<u8>(slot.width >> 8);
+  msg[6] = static_cast<u8>(slot.height & 0xFF);
+  msg[7] = static_cast<u8>(slot.height >> 8);
+  std::memcpy(msg.data() + 8, slot.pixels.data(), bytes);
+}
+
+// One frame newer than the request's `after`, or a 204 once FRAME_WAIT_MS has passed with
+// nothing new. False when the connection should be closed.
+bool ServeFrame(int sock, const Request& r)
+{
+  State& s = S();
+  const int wanted = RequestedDevice(r);
+  const u32 after = ParseUInt(QueryValue(r.query, "after"), 0, 0xFFFFFFFFu);
+  const bool compress = QueryValue(r.query, "z") == "1";
+  const bool have_min = !QueryValue(r.query, "min").empty();
+  const u32 min_seq = ParseUInt(QueryValue(r.query, "min"), 0, 0xFFFFFFFFu);
+
+  const long long arrived = NowMs();
+  if (arrived - s.last_view_ms.load() > VIEWER_GRACE_MS)
+    INFO_LOG_FMT(SERIALINTERFACE, "GBA web: a browser started polling frames");
+  s.last_view_ms = arrived;
+
+  std::vector<u8> msg;
+  std::vector<u16> copy;  // for the compressed form, which is made outside the lock
+  u16 copy_width = 0, copy_height = 0;
+  u32 seq = after;
+  bool have = false;
+  {
+    std::unique_lock lock(s.m);
+    for (;;)
+    {
+      if (s.stop)
+        return false;
+      const int d = wanted >= 0 ? wanted : LowestActive(s);
+      if (d >= 0)
+      {
+        const Slot& slot = s.slots[d];
+        if (have_min)
+          seq = slot.seq;  // what a 204 reports, so the page can see where the numbering is
+        if (!slot.pixels.empty() && (have_min ? slot.seq >= min_seq : slot.seq != after))
+        {
+          if (compress)
+          {
+            copy = slot.pixels;
+            copy_width = slot.width;
+            copy_height = slot.height;
+          }
+          else
+          {
+            BuildFrameMessage(slot, msg);
+          }
+          seq = slot.seq;
+          have = true;
+          break;
+        }
+      }
+      const long long left = FRAME_WAIT_MS - (NowMs() - arrived);
+      if (left <= 0)
+        break;
+      s.cv.wait_for(lock, std::chrono::milliseconds(std::min<long long>(left, 100)));
+    }
+  }
+  s.last_view_ms = NowMs();
+
+  if (have && compress)
+  {
+    std::vector<u8> packed;
+    CompressFrame(copy, copy_width, packed);
+    msg.resize(12 + packed.size());
+    msg[0] = 'G';
+    msg[1] = 'B';
+    msg[2] = 'A';
+    msg[3] = '2';
+    msg[4] = static_cast<u8>(copy_width & 0xFF);
+    msg[5] = static_cast<u8>(copy_width >> 8);
+    msg[6] = static_cast<u8>(copy_height & 0xFF);
+    msg[7] = static_cast<u8>(copy_height >> 8);
+    const u32 len = static_cast<u32>(packed.size());
+    msg[8] = static_cast<u8>(len & 0xFF);
+    msg[9] = static_cast<u8>((len >> 8) & 0xFF);
+    msg[10] = static_cast<u8>((len >> 16) & 0xFF);
+    msg[11] = static_cast<u8>(len >> 24);
+    std::memcpy(msg.data() + 12, packed.data(), packed.size());
+  }
+
+  const std::string seq_header = "X-Seq: " + std::to_string(seq) + "\r\n";
+  if (!have)
+  {
+    ++s.idle_polls;
+    return SendText(sock, Header(204, "No Content", nullptr, 0, true, seq_header));
+  }
+  const long long t0 = NowMs();
+  if (!SendText(sock, Header(200, "OK", "application/octet-stream", msg.size(), true, seq_header)) ||
+      !SendAll(sock, msg.data(), msg.size()))
+    return false;
+  const long long took = NowMs() - t0;
+  long long prev = s.max_send_ms.load();
+  while (took > prev && !s.max_send_ms.compare_exchange_weak(prev, took))
+  {
+  }
+  ++s.frames_served;
+  s.bytes_served += msg.size();
+  return true;
+}
+
+struct ViewerGuard
+{
+  std::atomic<int>& n;
+  explicit ViewerGuard(std::atomic<int>& v) : n(v) { ++n; }
+  ~ViewerGuard() { --n; }
+};
+
+void Stream(int sock, const Request& r)
+{
+  State& s = S();
+  const int wanted = RequestedDevice(r);
+  unsigned div = ParseUInt(QueryValue(r.query, "div"), 2, 6);
+  if (div == 0)
+    div = 1;
+
+  static constexpr char HEAD[] =
+      "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nCache-Control: no-store\r\n"
+      "X-Content-Type-Options: nosniff\r\nConnection: close\r\n\r\n";
+  if (!SendAll(sock, HEAD, sizeof(HEAD) - 1))
+    return;
+
+  if (wanted >= 0)
+    INFO_LOG_FMT(SERIALINTERFACE, "GBA web: stream started (port {}, every {} frame)", wanted + 1, div);
+  else
+    INFO_LOG_FMT(SERIALINTERFACE, "GBA web: stream started (any port, every {} frame)", div);
+  const ViewerGuard guard(s.viewers);
+
+  u32 last_seq = 0;
+  int last_dev = -2;
+  long long last_sent = 0;
+  std::vector<u8> msg;
+  for (;;)
+  {
+    bool have = false;
+    {
+      std::unique_lock lock(s.m);
+      s.cv.wait_for(lock, std::chrono::milliseconds(200), [&] {
+        if (s.stop)
+          return true;
+        const int d = wanted >= 0 ? wanted : LowestActive(s);
+        return d >= 0 && (d != last_dev || s.slots[d].seq != last_seq);
+      });
+      if (s.stop)
+        break;
+      const int d = wanted >= 0 ? wanted : LowestActive(s);
+      if (d >= 0)
+      {
+        const Slot& slot = s.slots[d];
+        if (d != last_dev)
+        {
+          last_dev = d;
+          last_seq = 0;
+        }
+        if (slot.seq != last_seq && !slot.pixels.empty())
+        {
+          BuildFrameMessage(slot, msg);
+          last_seq = slot.seq;
+          have = true;
+        }
+      }
+    }
+    // Paced by the clock: a remainder of the frame number can lock onto a value that never comes
+    // up when frames arrive in uneven bursts.
+    if (!have || NowMs() - last_sent < static_cast<long long>(div) * 1000 / 60)
+      continue;
+    last_sent = NowMs();
+    if (!SendAll(sock, msg.data(), msg.size()))
+      break;
+  }
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA web: stream ended");
+}
+
+void HandleClient(Fd conn, Client* client)
+{
+  State& s = S();
+  const int sock = conn.Get();
+  std::string buf;
+  for (;;)
+  {
+    std::string head;
+    Request r;
+    if (!ReadHead(sock, buf, head))
+      break;
+    if (!ParseRequest(head, r))
+    {
+      (void)SendText(sock, Header(400, "Bad Request", nullptr, 0, false));
+      break;
+    }
+    if (r.method != "GET")
+    {
+      (void)SendText(sock, Header(405, "Method Not Allowed", nullptr, 0, false));
+      break;
+    }
+
+    if (r.path == "/" || r.path == "/index.html")
+    {
+      INFO_LOG_FMT(SERIALINTERFACE, "GBA web: page requested");
+      (void)SendText(sock, Header(200, "OK", "text/html; charset=utf-8", sizeof(PAGE) - 1, false));
+      (void)SendAll(sock, PAGE, sizeof(PAGE) - 1);
+      break;
+    }
+    if (r.path == "/k")
+    {
+      const u16 mask = static_cast<u16>(ParseUInt(QueryValue(r.query, "m"), 0, 0x3FF));
+      int dev = RequestedDevice(r);
+      if (dev < 0)
+      {
+        std::lock_guard lock(s.m);
+        dev = LowestActive(s);
+      }
+      if (dev >= 0)
+      {
+        const u16 before = HW::GBA::ExternalKeys(dev).exchange(mask);
+        if (before != mask && s.key_log_budget.fetch_sub(1) > 0)
+          DEBUG_LOG_FMT(SERIALINTERFACE, "GBA web: port {} keys {:03x}", dev + 1, mask);
+      }
+      s.last_key_ms = NowMs();
+      if (!SendText(sock, Header(204, "No Content", nullptr, 0, true)))
+        break;
+      continue;
+    }
+    if (r.path == "/state")
+    {
+      std::string json = "{\"ports\":[";
+      {
+        std::lock_guard lock(s.m);
+        bool first = true;
+        for (int i = 0; i < MAX_DEVICES; ++i)
+        {
+          if (!s.slots[i].active)
+            continue;
+          json += (first ? "" : ",") + std::to_string(i + 1);
+          first = false;
+        }
+      }
+      json += "]}";
+      (void)SendText(sock, Header(200, "OK", "application/json", json.size(), false));
+      (void)SendText(sock, json);
+      break;
+    }
+    if (r.path == "/frame")
+    {
+      if (!ServeFrame(sock, r))
+        break;
+      continue;
+    }
+    if (r.path == "/stream")
+    {
+      Stream(sock, r);
+      break;
+    }
+    (void)SendText(sock, Header(404, "Not Found", nullptr, 0, false));
+    break;
+  }
+  client->done = true;
+}
+
+void AcceptLoop()
+{
+  State& s = S();
+  long long last_report = NowMs();
+  unsigned reported_seen = 0, reported_changed = 0, reported_served = 0;
+  while (!s.stop)
+  {
+    if (WaitReadable(s.listener, 100))
+    {
+      Fd conn(::accept(s.listener, nullptr, nullptr));
+      if (conn && conn.Get() < FD_SETSIZE && s.clients.size() < MAX_CLIENTS)
+      {
+        SetNonBlocking(conn.Get());
+        // Room for a whole frame (or a few), so one send() hands it to the network stack and the
+        // connection is limited by the link, not by a small default buffer and the round trip.
+        const int buffer = 512 * 1024;
+        (void)::setsockopt(conn.Get(), SOL_SOCKET, SO_SNDBUF, &buffer, sizeof(buffer));
+        const int yes = 1;
+        (void)::setsockopt(conn.Get(), IPPROTO_TCP, TCP_NODELAY, &yes, sizeof(yes));
+#ifdef SO_NOSIGPIPE
+        (void)::setsockopt(conn.Get(), SOL_SOCKET, SO_NOSIGPIPE, &yes, sizeof(yes));
+#endif
+        s.clients.emplace_back();
+        Client& c = s.clients.back();
+        c.thread = std::thread(HandleClient, std::move(conn), &c);
+      }
+    }
+
+    for (auto it = s.clients.begin(); it != s.clients.end();)
+    {
+      if (it->done)
+      {
+        it->thread.join();
+        it = s.clients.erase(it);
+      }
+      else
+      {
+        ++it;
+      }
+    }
+
+    if (NowMs() - last_report >= 5000)
+    {
+      last_report = NowMs();
+      const unsigned seen = s.frames_seen.load(), changed = s.frames_changed.load(),
+                     served = s.frames_served.load();
+      if (seen != reported_seen || served != reported_served)
+      {
+        // Per second over the last five: how many frames the GBA finished, how many of those
+        // differed from the one before, how many went out, and how long the slowest took to send.
+        INFO_LOG_FMT(SERIALINTERFACE,
+                     "GBA web: last 5 s: GBA made {} frames, {} changed, {} sent, {} idle polls, slowest "
+                     "send {} ms, {} KiB total",
+                     seen - reported_seen, changed - reported_changed, served - reported_served,
+                     s.idle_polls.exchange(0), s.max_send_ms.exchange(0), s.bytes_served.load() / 1024);
+        reported_seen = seen;
+        reported_changed = changed;
+        reported_served = served;
+      }
+    }
+
+    // A held button nobody refreshes (a closed tab, a lost network) must not stay held.
+    if (NowMs() - s.last_key_ms > KEY_EXPIRY_MS)
+    {
+      for (int i = 0; i < MAX_DEVICES; ++i)
+        HW::GBA::ExternalKeys(i).store(0);
+    }
+  }
+}
+
+void StartServer(State& s)  // with s.lifecycle held
+{
+  if (s.accept_thread.joinable())
+    return;
+  s.stop = false;
+  Fd listener = OpenListener(PORT);
+  if (!listener)
+  {
+    ERROR_LOG_FMT(SERIALINTERFACE, "GBA web: cannot listen on port {}", PORT);
+    return;
+  }
+  s.listener = listener.Get();
+  s.listener_owner = std::move(listener);
+  s.last_key_ms = NowMs();
+  s.accept_thread = std::thread(AcceptLoop);
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA web: serving on port {}", PORT);
+}
+
+void StopServer(State& s)  // with s.lifecycle held
+{
+  if (!s.accept_thread.joinable())
+    return;
+  s.stop = true;
+  s.cv.notify_all();
+  s.accept_thread.join();
+  for (Client& c : s.clients)
+    c.thread.join();
+  s.clients.clear();
+  s.listener = -1;
+  s.listener_owner.Reset();
+  s.stop = false;
+  s.frames_served = 0;
+  s.frames_seen = 0;
+  s.frames_changed = 0;
+  s.idle_polls = 0;
+  s.bytes_served = 0;
+  s.max_send_ms = 0;
+  s.last_view_ms = 0;
+  {
+    std::lock_guard lock(s.m);
+    for (Slot& slot : s.slots)
+      slot = Slot{};
+  }
+  INFO_LOG_FMT(SERIALINTERFACE, "GBA web: stopped");
+}
+
+class WebHost final : public GBAHostInterface
+{
+public:
+  explicit WebHost(int device) : m_device(device)
+  {
+    State& s = S();
+    std::lock_guard life(s.lifecycle);
+    {
+      std::lock_guard lock(s.m);
+      s.slots[m_device].active = true;
+    }
+    ++s.refs;
+    if (s.server_wanted)
+      StartServer(s);
+  }
+
+  ~WebHost() override
+  {
+    State& s = S();
+    std::lock_guard life(s.lifecycle);
+    HW::GBA::ExternalKeys(m_device).store(0);
+    HW::GBA::FrontendKeys(m_device).store(0);
+    {
+      std::lock_guard lock(s.m);
+      s.slots[m_device].active = false;
+    }
+    if (--s.refs <= 0)
+    {
+      s.refs = 0;
+      StopServer(s);
+    }
+  }
+
+  void GameChanged() override {}
+
+  // Called on the GBA's own thread, once per finished frame.
+  void FrameEnded(std::span<const u32> video) override
+  {
+    State& s = S();
+    const long long now = NowMs();
+    if (video.empty() ||
+        (s.viewers.load(std::memory_order_relaxed) == 0 &&
+         now - s.last_view_ms.load(std::memory_order_relaxed) > VIEWER_GRACE_MS))
+      return;
+    // The first frame after a pause (nobody watching) is published even if it equals the last
+    // one kept: that one may be from long ago, and a still screen would never send another.
+    const bool resumed = now - m_last_converted_ms > 250;
+    m_last_converted_ms = now;
+
+    u16 width = 240;
+    u16 height = static_cast<u16>(std::min<std::size_t>(video.size() / 240, 0xFFFF));
+    if (video.size() == 160 * 144)
+    {
+      width = 160;
+      height = 144;
+    }
+
+    ++s.frames_seen;
+
+    // Converted outside the lock. mGBA's pixels are 0x00BBGGRR with each channel's top five bits
+    // significant.
+    m_scratch.resize(std::size_t{width} * height);
+    const std::size_t n = std::min(m_scratch.size(), video.size());
+    for (std::size_t i = 0; i < n; ++i)
+    {
+      const u32 v = video[i];
+      m_scratch[i] = static_cast<u16>(((v >> 3) & 0x1F) | (((v >> 11) & 0x1F) << 5) |
+                                      (((v >> 19) & 0x1F) << 10));
+    }
+
+    {
+      std::lock_guard lock(s.m);
+      Slot& slot = s.slots[m_device];
+      // A picture that has not changed is not a new frame: still screens (most of the Tingle
+      // Tuner's) then cost the browser nothing.
+      if (!resumed && slot.width == width && slot.height == height && slot.pixels == m_scratch)
+        return;
+      slot.width = width;
+      slot.height = height;
+      slot.pixels.swap(m_scratch);
+      ++slot.seq;
+    }
+    ++s.frames_changed;
+    s.cv.notify_all();
+  }
+
+private:
+  const int m_device;
+  std::vector<u16> m_scratch;  // the GBA thread's own
+  long long m_last_converted_ms = 0;  // the GBA thread's own
+};
+}  // namespace
+
+std::unique_ptr<GBAHostInterface> CreateHost(std::weak_ptr<HW::GBA::Core> core)
+{
+  const auto locked = core.lock();
+  if (!locked)
+    return nullptr;
+  const int device = locked->GetCoreInfo().device_number;
+  if (device < 0 || device >= MAX_DEVICES)  // the Game Boy Player's GBA has no screen to show
+    return nullptr;
+  return std::make_unique<WebHost>(device);
+}
+}  // namespace Libretro::GBAWeb
