 }
 
+// GBA link: the GBA in SI port `port` (0-3) on its own, for a controller's speaker (stereo frames
+// at the mixer's rate, porpoise_wiimote_speaker_rate). The first call keeps that GBA out of the
+// TV's sound; porpoise_route_gba(port, 0) puts it back.
+extern "C" __attribute__((visibility("default"))) void porpoise_route_gba(unsigned port, int routed)
+{
+  std::lock_guard<std::mutex> lock(g_porpoise_sound_stream_lock);
+  SoundStream* sound_stream = Core::System::GetInstance().GetSoundStream();
+  if (sound_stream && sound_stream->GetMixer())
+    sound_stream->GetMixer()->SetGBARouted(port, routed != 0);
+}
+
+// The GBA in SI port `port`'s volume, 0 (silent) to 256 (full), in the TV's sound and the
+// controller's alike: Dolphin's own GBA window's Volume and Mute (GBAWidget::UpdateVolume).
+extern "C" __attribute__((visibility("default"))) void porpoise_gba_volume(unsigned port, unsigned volume)
+{
+  std::lock_guard<std::mutex> lock(g_porpoise_sound_stream_lock);
+  SoundStream* sound_stream = Core::System::GetInstance().GetSoundStream();
+  if (sound_stream && sound_stream->GetMixer() && port < 4)
+    sound_stream->GetMixer()->SetGBAVolume(port, std::min(volume, 256u), std::min(volume, 256u));
+}
+
+extern "C" __attribute__((visibility("default"))) size_t porpoise_mix_gba(unsigned port, int16_t* stereo,
+                                                                        size_t frames)
+{
+  std::lock_guard<std::mutex> lock(g_porpoise_sound_stream_lock);
+  SoundStream* sound_stream = Core::System::GetInstance().GetSoundStream();
+  if (!sound_stream || !sound_stream->GetMixer() || !stereo)
+    return 0;
+  sound_stream->GetMixer()->SetGBARouted(port, true);
+  return sound_stream->GetMixer()->MixGBA(port, stereo, frames);
+}
+
 // Porpoise: the game's sound pulled at the speakers' pace, as Dolphin's own audio backends
 // do, so Dolphin's mixer fills the gaps when a game runs slow (instead of the front end's
 // queue running dry and crackling). pull 0 goes back to the sound pushed each frame.
